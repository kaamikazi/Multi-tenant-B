# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings -> API (or `npx supabase projects api-keys --reveal`).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by the seed script and Stripe webhooks; never exposed to the browser.
SUPABASE_SECRET_KEY=

# Canonical origin for every generated link (auth emails, invites, booking,
# Stripe redirects). REQUIRED in production and must be https; request
# Host/Origin headers are never trusted for this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe TEST mode only (sk_test_...). Billing runs as a read-only demo when unset.
STRIPE_SECRET_KEY=
# Signing secret of your Stripe webhook endpoint (…/api/stripe/webhook), or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Optional: pin the Pro price id(s), comma-separated. Otherwise resolved by the
# lookup key tenantflow_pro_monthly (created by `npm run stripe:setup`).
# STRIPE_PRO_PRICE_ID=

# Server-only shared secret for /api/cron/reconcile-billing (32+ random chars,
# e.g. `openssl rand -hex 32`). The endpoint 404s when unset.
CRON_SECRET=

# Gemini (Google AI Studio) key for the AI assistant. The assistant is disabled when unset.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.5-flash with automatic fallbacks.
# GEMINI_MODEL=

# Optional shared rate-limit store for public booking (Upstash Redis REST, has
# a free tier). Without it, limits are counted per server process.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile CAPTCHA on the public booking form (free).
# Set BOTH or neither; half-configured refuses bookings. The secret is server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# The demo seed (npm run seed) deletes and recreates the demo accounts. It
# refuses to run unless this is set, and never runs with NODE_ENV=production.
# ALLOW_DESTRUCTIVE_DEMO_SEED=true
