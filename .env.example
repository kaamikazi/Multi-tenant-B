# Local values come from `npx supabase status` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used for seeding and Stripe webhooks; never exposed to the browser.
SUPABASE_SECRET_KEY=

# Used for auth email redirect links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe TEST mode only (sk_test_...). Billing is disabled when unset.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint, or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=

# Gemini (Google AI Studio) key for the AI assistant. Assistant is disabled when unset.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-flash-latest.
# GEMINI_MODEL=
